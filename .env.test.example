# ============================================================
# npm run test:integration — credentials for wacrm-staging ONLY.
#
# Copy this file to .env.test.local (gitignored, never committed)
# and fill in real values. These tests create and delete real
# accounts and auth users against staging. A hardcoded guard
# (tests/integration/setup/guard-staging.ts) refuses to run unless
# SUPABASE_TEST_URL points at the staging project
# (ref zkrjdsqkfokzoifslfve) — never point these at production.
# ============================================================

# Staging project URL (Project Settings → API).
SUPABASE_TEST_URL=https://zkrjdsqkfokzoifslfve.supabase.co

# Staging service-role key. Bypasses RLS — needed to create/delete
# test accounts and users and to call RPCs directly. Never the
# production key.
SUPABASE_TEST_SERVICE_ROLE_KEY=your-staging-service-role-key
